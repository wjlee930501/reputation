# ══════════════════════════════════════════════════════════════════
# Re:putation — 프로덕션 환경변수 템플릿 (Cloud Run)
#
# API 키는 Secret Manager에서 주입되므로 여기에 적지 않습니다.
# 대신 .env.production에는 인프라 연결 정보만 넣습니다.
#
# cp .env.production.example .env.production
# ══════════════════════════════════════════════════════════════════

# ── App ───────────────────────────────────────────────────────────
APP_ENV=production
GCP_PROJECT_ID=REPLACE_ME

# ── Database (Cloud SQL) ──────────────────────────────────────────
# DB_PASSWORD는 Secret Manager에서 주입합니다.
DB_USER=reputation
DB_NAME=reputation
CLOUD_SQL_CONNECTION_NAME=project:region:instance
# 커넥션 풀 예산. scripts/check_db_connection_budget.py가 api·worker 인스턴스 상한과
# 이 값들을 곱해 Cloud SQL max_connections 안에 들어오는지 검사한다.
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT=30
DB_WORKER_POOL_SIZE=2
DB_WORKER_MAX_OVERFLOW=2
DB_CONNECT_TIMEOUT=10
DB_COMMAND_TIMEOUT=30

# ── Redis (Memorystore) ───────────────────────────────────────────
# Serverless VPC Access 커넥터로 연결
REDIS_URL=redis://REPLACE_ME:6379/0

# ── Celery (worker) ───────────────────────────────────────────────
# terraform/cloudrun.tf의 worker env와 같은 값을 유지한다. Cloud SQL max_connections
# 예산 계산(scripts/check_db_connection_budget.py)이 이 값을 전제로 한다.
CELERY_CONCURRENCY=2
CELERY_MAX_TASKS_PER_CHILD=50

# ── Google Cloud ──────────────────────────────────────────────────
# GCP_PROJECT_ID는 위 App 섹션에서 한 번만 정의한다 — 중복 키는 deploy.sh가 만드는
# --env-vars-file YAML에 같은 키를 두 번 쓰게 되어 gcloud가 거부한다.
# 버킷명은 전역 유일 제약 때문에 '<name>-<GCP_PROJECT_ID>' 규칙을 쓴다
# (terraform storage.tf / setup-gcp.sh가 동일 규칙으로 생성). placeholder 기본값
# 'reputation-images'/'reputation-reports' 그대로 두면 backend 부팅 WARNING + deploy.sh preflight 실패.
GCP_STORAGE_BUCKET=reputation-images-REPLACE_ME
GCS_REPORTS_BUCKET=reputation-reports-REPLACE_ME

# Cloud Run에서 Application Default Credentials 자동 사용
# GOOGLE_APPLICATION_CREDENTIALS 불필요

# ── Admin ─────────────────────────────────────────────────────────
ADMIN_BASE_URL=https://admin.reputation.motionlabs.kr
ADMIN_ACTOR_NAME=AE
# 세션에서 행위자를 검증하지 못한 Admin 쓰기 요청을 거부한다. 프로덕션에서 내리지 말 것.
ADMIN_REJECT_UNVERIFIED_ACTOR=true

# ── 산출물 로컬 경로 (GCS 업로드 전 임시 작업 디렉터리) ───────────
# 컨테이너의 쓰기 가능 경로여야 한다 — backend/Dockerfile이 이 두 경로를 만들고
# appuser에게 소유권을 준다.
REPORT_OUTPUT_DIR=/tmp/reports
ASSET_LOCAL_UPLOAD_DIR=/tmp/private_asset_uploads

# ── Site ──────────────────────────────────────────────────────────
SITE_BASE_URL=https://reputation.motionlabs.kr
CNAME_TARGET=cname.reputation.motionlabs.kr
CUSTOM_DOMAIN_IP_TARGETS=REPLACE_WITH_LB_IP
# CORS — production boot FAILS if this contains '*', http://, or localhost (AUTH-5/INFRA-3).
ALLOWED_ORIGINS=https://admin.reputation.motionlabs.kr,https://reputation.motionlabs.kr

# ── Proxy / client IP (AUTH-1) ────────────────────────────────────
# Real LB/proxy CIDR ranges fronting Cloud Run. Backend parses X-Forwarded-For
# right-to-left and returns the first entry NOT in these ranges as the client IP.
# MUST NOT be 0.0.0.0/0 (would make the client IP spoofable — boot FAILS on it).
# Default below is the GCP global external LB / GFE range; verify for your setup.
# Production boot also FAILS if this is localhost-only.
TRUSTED_PROXY_IPS=130.211.0.0/22,35.191.0.0/16

# ── Site Revalidate ───────────────────────────────────────────────
SITE_REVALIDATE_URL=https://reputation.motionlabs.kr/api/revalidate
SITE_REVALIDATE_SECRET=REPLACE_ME

# ── Site BFF visitor IP (CDX-M1) ──────────────────────────────────
# site의 /api/leads BFF와 공유하는 secret. 설정 시 BFF가 X-BFF-Auth +
# X-Visitor-IP로 실제 방문자 IP를 전달하고 backend가 rate-limit key/consent_ip에
# 채택한다. site Cloud Run 서비스(terraform이 Secret Manager에서 마운트)와
# 동일 값 필요 — 전체 GCP 구성에서는 같은 secret을 양쪽이 읽으므로 자동 일치.
SITE_BFF_SECRET=REPLACE_ME

# ── Certificate Manager (커스텀 도메인 자동 온보딩) ───────────────
# terraform/cloudrun.tf가 선언하는 키다. deploy.sh는 --env-vars-file로 기존 env를
# 통째로 교체하므로 여기 없으면 Cloud Run에서 조용히 사라지고, cloudrun.tf의
# ignore_changes 때문에 terraform apply로도 복구되지 않는다.
# AUTO_PROVISION=false면 deploy.sh preflight가 배포를 거부한다.
CERTIFICATE_MANAGER_AUTO_PROVISION=true
CERTIFICATE_MANAGER_LOCATION=global
CERTIFICATE_MAP_NAME=reputation-certmap

# ── Sentry ────────────────────────────────────────────────────────
# terraform이 선언하는 키이므로 값이 없더라도 키 자체는 남겨 둔다 — 주석 처리하면
# deploy.sh의 drop 감지 preflight가 실패한다. 빈 값은 "설정 안 함"으로 전달되지 않는다.
SENTRY_DSN=

# ── SoV ───────────────────────────────────────────────────────────
# Locked August 2026 conversion envelope for H=7 named hospitals.
# 1260 = 7×15×2×5 + 210 retry remainder. 4260 = 3000 already-used + 1260 today.
# NOT a weekly full-sample raise. Register the 7 tracking sets first, then apply.
COST_GUARD_MONTHLY_SOV_QUERIES=4260
COST_GUARD_DAILY_SOV_QUERIES=1260
# LIMIT=7 converts matching valid tracking-set hospitals. 0/negative stays empty.
# 0 does NOT mean all hospitals.
SOV_MONTHLY_COHORT_LIMIT=7
SOV_TRACKING_SET_N_DEFAULT=15
SOV_MONTHLY_WINDOW_START_DAY=24
SOV_REPEAT_COUNT_WEEKLY=5
# 병원별 질의 사양 상한 — tracking set 구성 시 우선순위 질의와 전체 질의 수를 제한한다.
SOV_HIGH_PRIORITY_CAP=30
SOV_TOTAL_SPEC_CAP=50
# 프로덕션 언급률은 실제 web_search 답변만 측정한다. false면 deploy.sh가 배포를 거부한다.
OPENAI_CHATGPT_USE_WEB_SEARCH=true

# ── Model ─────────────────────────────────────────────────────────
# 측정 모델 3종(OPENAI_MODEL_QUERY/PARSE, GEMINI_MODEL)은 반드시 날짜·버전 고정
# 스냅샷이어야 한다. gpt-4o / gemini-flash-latest 같은 부동 별칭은 공급자가 갱신할 때
# 측정 기준선을 조용히 이동시켜 월별 비교를 무의미하게 만든다 —
# deploy.sh의 require_pinned_measurement_models가 배포를 거부한다.
# 값은 backend/app/core/config.py의 고정 기본값과 일치시킨다.
CLAUDE_MODEL=claude-sonnet-4-5
CLAUDE_MODEL_FAST=claude-haiku-4-5-20251001
# 비우면 CLAUDE_MODEL_FAST를 쓴다(프로파일 자동 채우기).
AUTOFILL_MODEL=
IMAGE_PROVIDER=google
GOOGLE_IMAGE_MODEL=gemini-3.1-flash-image
GOOGLE_IMAGE_LOCATION=global
# IMAGE_PROVIDER=openai일 때만 쓰이는 폴백 경로 설정.
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1536x864
OPENAI_IMAGE_QUALITY=high
OPENAI_MODEL_QUERY=gpt-5.6-luna
OPENAI_MODEL_PARSE=gpt-4o-mini-2024-07-18
GEMINI_MODEL=gemini-3.6-flash
# Jina Reader — 봇 차단 사이트 읽기(프로파일 자동 채우기). 비우면 무인증 free tier.
JINA_API_KEY=

# ── 비용 가드 (유료 외부 호출 상한) ───────────────────────────────
# SoV 상한은 위 SoV 섹션에 있다. false로 내리면 모든 유료 호출이 무제한이 된다.
COST_GUARD_ENABLED=true
COST_GUARD_DAILY_CONTENT_CALLS=250
COST_GUARD_MONTHLY_CONTENT_CALLS=3000
COST_GUARD_DAILY_IMAGE_CALLS=250
COST_GUARD_MONTHLY_IMAGE_CALLS=3000
COST_GUARD_DAILY_LEADGEN_CALLS=500
COST_GUARD_MONTHLY_LEADGEN_CALLS=12000

# ── IndexNow (발행 직후 검색엔진 URL 제출) ────────────────────────
# INDEXNOW_KEY(Secret Manager)가 비면 이 플래그가 true여도 제출을 건너뛴다.
INDEXNOW_ENABLED=true

# ── Lead Retention ────────────────────────────────────────────────
LEAD_RETENTION_DAYS=180
LEAD_CONSENT_VERSION=v1.2026-08
PUBLIC_LEAD_RATE_LIMIT=5/minute;30/hour;100/day
# Public 콘텐츠 허브 읽기 API rate-limit (AUTH-2)
PUBLIC_SITE_RATE_LIMIT=300/minute;6000/hour
# 무료 진단(리드 마그넷) 처리량과 캐시. 하루 선착순 자리 수 · 질의당 반복 측정 수 ·
# 공급자 동시 호출 수 · 질의 응답 캐시 보존일.
LEADGEN_DAILY_SLOTS=20
LEADGEN_REPEAT_COUNT=3
LEADGEN_PROVIDER_CONCURRENCY=15
LEADGEN_QUERY_CACHE_TTL_DAYS=7
# 진단 리포트·상태 페이지 열람 링크의 유효기간.
LEAD_REPORT_TOKEN_TTL_DAYS=30
# 리포트 전달 메일 발신자. 비우면 회신 주소를 붙이지 않는다.
LEAD_MAIL_FROM=Re:putation <noreply@reputation.motionlabs.kr>
LEAD_MAIL_REPLY_TO=
# 리포트 PDF 하단에 실리는 담당자 연락처.
LEAD_REPORT_CONTACT_NAME=김효진
LEAD_REPORT_CONTACT_ROLE=Re:putation 마케팅 팀장
LEAD_REPORT_CONTACT_EMAIL=hjkim@motionlabs.kr
LEAD_REPORT_CONTACT_PHONE=070-8671-0100

# ── Observability (OBS-1) ─────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON=true

# ── Slack webhook SSRF guard (EXT-1/V-013) ────────────────────────
SLACK_WEBHOOK_ALLOWED_HOSTS=hooks.slack.com

# ── API 키는 Secret Manager에서 주입 ──────────────────────────────
# ANTHROPIC_API_KEY → gcloud secrets versions add ANTHROPIC_API_KEY --data-file=-
# OPENAI_API_KEY    → gcloud secrets versions add OPENAI_API_KEY --data-file=-
# GEMINI_API_KEY    → gcloud secrets versions add GEMINI_API_KEY --data-file=-
# ADMIN_SECRET_KEY  → gcloud secrets versions add ADMIN_SECRET_KEY --data-file=-
# WORKER_DISPATCH_SECRET → gcloud secrets versions add WORKER_DISPATCH_SECRET --data-file=-
# ADMIN_SESSION_SECRET → gcloud secrets versions add ADMIN_SESSION_SECRET --data-file=-
# DB_PASSWORD       → gcloud secrets versions add DB_PASSWORD --data-file=-
# SLACK_WEBHOOK_URL → gcloud secrets versions add SLACK_WEBHOOK_URL --data-file=-
# SLACK_WEBHOOK_URL_DEV → gcloud secrets versions add SLACK_WEBHOOK_URL_DEV --data-file=-
#   개발팀 전용 채널(선택). 인프라 인시던트만 이쪽으로 나간다. 채널을 나누지 않을
#   경우에도 빈 값으로 버전 하나는 만들어 둔다(deploy.sh가 optional secret으로 mount).

# ── Admin 최고 권한 계정 생성/회전 ────────────────────────────────
# DB 마이그레이션 후 backend 컨테이너/작업 환경에서 실행:
# ADMIN_EMAIL=owner@example.com ADMIN_NAME=Owner ADMIN_PASSWORD='...' python -m app.utils.admin_user create-owner
# ADMIN_PASSWORD는 Secret Manager나 Terraform state에 저장하지 말고 1Password 등에서 일회성으로 주입하세요.
