# Public surface (required for production builds)
NEXT_PUBLIC_SITE_URL=https://reputation.motionlabs.kr
NEXT_PUBLIC_API_URL=https://reputation.motionlabs.kr/api/v1/public
NEXT_PUBLIC_BACKEND_URL=https://reputation.motionlabs.kr

# Optional — BFF auth when forwarding leads/diagnosis to the reputation backend
# SITE_BFF_SECRET=

# Optional — GA4 measurement id.
# motionlabs.kr 계열 호스트는 이 값이 없어도 공유 속성(G-K8DQWCD39Y)으로 계측한다
# (lib/analytics.ts). 이 변수는 병원 커스텀 도메인에서 계측을 켜거나, 다른 속성으로
# 바꿔 볼 때만 쓴다. 로컬에서 DebugView를 볼 때도 여기에 테스트 속성을 넣는다.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=


# Optional — 서비스 소개서(/brochure).
# 홈·푸터의 소개서 진입 링크를 켠다. 백엔드가 /brochure-leads, /brochure-events를
# 받을 수 있게 배포된 뒤에 1로 둔다(빌드 시점 값). /brochure 자체는 항상 열려 있다.
# NEXT_PUBLIC_BROCHURE_ENABLED=1
# 열람 토큰 서명 키. 비우면 SITE_BFF_SECRET을 쓰고, 둘 다 없으면 개발용 고정 키를 쓴다.
# BROCHURE_TOKEN_SECRET=
