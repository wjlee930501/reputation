# Python
__pycache__/
*.py[cod]
*.pyo
.env
# .env.production 등 모든 dotenv 변형 차단 (deploy.sh가 리포 루트에 작성 지시) —
# 템플릿(.example)만 추적 허용.
.env.*
!.env.example
!.env.*.example
.venv
venv/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.log

# Node
node_modules/
.next/
out/
*.local

# Build artifacts
/tmp/sites/
/tmp/reports/
reports/
*.tsbuildinfo
celerybeat-schedule
backend/celerybeat-schedule
.hermes/

# IDE
.DS_Store
.vscode/
.idea/

# OMC state
.omc/
.omo/
.sisyphus/
.claude/

# Secrets
*.pem
*.key
service-account.json
google-credentials.json
*.bak

# Local artifacts (sales decks, drafts, agent prompts, scratch scripts)
*.docx
*.pdf
AGENTS.md
generate-report.js
docs/superpowers/

# Research and audit output — screenshots and logs stay local; written reports
# and the scripts that reproduce a capture are tracked, because DESIGN.md and
# the competitor review cite them as evidence.
artifacts/**
!artifacts/**/
!artifacts/**/*.md
!artifacts/**/*.html
!artifacts/**/*.sh
!artifacts/**/*.py

# scripts/deploy.sh가 배포 직전에 남기는 롤백 기준 리비전 (머신 로컬 상태)
.deploy-rollback

# Terraform
# .terraform.lock.hcl은 의도적으로 추적한다 — provider 버전이 클론마다 달라지면
# google_sql_database_instance 등에서 destroy/create 계획이 나올 수 있다.
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/terraform.tfvars
